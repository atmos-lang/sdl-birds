val sdl = require "atmos.env.sdl"
val SDL = require "SDL"
val IMG = require "SDL.image"

val _,REN = sdl.window [
	title  = "Birds - 06 (pool/scope)",
	width  = 640,
	height = 480,
    flags  = [ SDL.flags.OpenGL ],
] --> assert

val UP = tex where {
    sfc = IMG.load("res/bird-up.png") --> assert
    tex = REN::createTextureFromSurface(sfc) --> assert
}

val DN = tex where {
    sfc = IMG.load("res/bird-dn.png") --> assert
    tex = REN::createTextureFromSurface(sfc) --> assert
}

val W,H = do {
    val _,_,a,b = UP::query()
    val _,_,c,d = DN::query()
    assert((a==c) && (b==d))
    (a,b)
}

math.randomseed()

task Bird (y, speed) {
    var xx  = 0
    var yy  = y
    var img = DN
    watching until \{xx>640} {
        par {
            var ang = 0
            loop us on :clock {
                val v = (speed * us) / 1000
                set xx = xx + (v/1000)
                set yy = y - ((speed/5) * math.sin(ang))
                set ang = ang + ((3.14*v)/100000)
                val tmp = ((ang+(3.14/2)) / 3.14) --> math.floor
                set img = if (tmp%2)==0 => UP => DN
            }
        } with {
            loop on :sdl.draw {
                REN::copy(img, nil, [x=xx->math.floor,y=yy->math.floor,w=W,h=H])
            }
        }
    }
}

loop {
    watching :sdl [type=SDL.event.MouseButtonDown] {
        pin birds = tasks(5)
        loop on 500ms {
            spawn @birds Bird(math.random(0,480), 100 + math.random(0,100))
        }
    }
}
